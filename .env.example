# Neon Postgres — pooled connection, used by the app at runtime
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true&connect_timeout=15"

# Neon Postgres — direct connection, used by `prisma migrate`
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Admin panel (/admin) — set both to random values in production
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="change-me-too"

# Partner accounts (/partner) — set to a random value in production
PARTNER_SESSION_SECRET="change-me-as-well"

# Optional — email notifications on scope approve/reject, sent via SMTP
# (defaults to Gmail). Leave unset and the app runs fine; approvals just
# won't send an email. For Gmail, SMTP_PASS is an App Password, not your
# regular password: https://myaccount.google.com/apppasswords
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="you@example.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# EMAIL_FROM="Overview <you@example.com>"
