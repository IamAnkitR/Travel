// Prisma schema for Overview Travel

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model State {
  id       String   @id @default(cuid())
  slug     String   @unique
  name     String
  emoji    String
  gradient String
  featured Boolean  @default(false)
  order    Int      @default(0)

  destinations Destination[]
}

model Destination {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  emoji       String
  gradient    String
  bestTime    String
  budget      String
  stay        String
  altitude    String
  rating      Float
  description String
  whyVisit    String   // JSON-encoded string[]
  tags        String   // JSON-encoded string[]
  order       Int      @default(0)

  stateId String
  state   State  @relation(fields: [stateId], references: [id])

  businesses     Business[]
  accountScopes  AccountScope[]
}

model Business {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  category      String  @default("Stay") // Stay | Package | Experience | Transport
  type          String // subtype within category, e.g. Hotel | Resort | Homestay | Budget
  location      String
  description   String
  rating        Float
  reviews       Int
  price         Int
  originalPrice Int?
  image         String // gradient token
  tags          String // JSON-encoded string[]
  order         Int     @default(0)
  views         Int     @default(0)

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  ownerId String?
  owner   BusinessAccount? @relation(fields: [ownerId], references: [id])

  scopeId String?
  scope   AccountScope? @relation(fields: [scopeId], references: [id])

  amenities Amenity[]
  rooms     Room[]
  host      Host?
  leads     Lead[]
  auditLogs AuditLog[]
}

model BusinessAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  contactName  String
  businessName String
  phone        String?
  createdAt    DateTime @default(now())

  scopes      AccountScope[]
  businesses  Business[]
  resetTokens PasswordResetToken[]
}

// A single-use, time-limited password reset link. Only the SHA-256 hash of
// the token is stored, so a DB read alone can't be used to reset a password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  accountId String
  account   BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

enum ScopeStatus {
  PENDING
  APPROVED
  REJECTED
}

// A single (destination, category, type) combination a partner has
// requested to publish under. An account can hold several — e.g. a chain
// with branches in different towns, or offering both stays and packages.
model AccountScope {
  id              String      @id @default(cuid())
  category        String // Stay | Package | Experience | Transport
  type            String // subtype within category
  status          ScopeStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime    @default(now())
  reviewedAt      DateTime?

  accountId String
  account   BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  businesses Business[]

  @@index([accountId])
}

model Amenity {
  id         String   @id @default(cuid())
  label      String
  icon       String
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Room {
  id         String   @id @default(cuid())
  name       String
  price      Int
  size       String
  guests     String
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Host {
  id            String   @id @default(cuid())
  name          String
  title         String
  yearsOnPlatform Int
  responseTime  String
  businessId    String   @unique
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Lead {
  id         String   @id @default(cuid())
  guestName  String
  channel    String // WhatsApp | Call
  createdAt  DateTime @default(now())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// Records admin edits to a partner-owned business, for dispute resolution.
model AuditLog {
  id         String   @id @default(cuid())
  actor      String // "admin" today; room for named admins later
  field      String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// Backs simple fixed-window rate limiting for public write endpoints
// (registration, login). Key is typically "<route>:<ip>".
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}
